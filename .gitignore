# --- Rust / Cargo (backend, incl. Tauri's src-tauri) ---
/target/
**/target/
src-tauri/target/
**/*.rs.bk
*.pdb

# --- Node / web frontend ---
node_modules/
dist/
dist-ssr/
.vite/
build/
*.local

# --- Tauri build output ---
src-tauri/gen/
src-tauri/WixTools/

# --- Generated WASM package (wasm-pack output; rebuilt by `npm run build:wasm`) ---
src/wasm/

# --- Local LLM model files (loaded from disk at runtime, never committed) ---
*.gguf
*.bin
*.safetensors
/models/

# --- Vector store / RAG artifacts (LanceDB) ---
*.lance
/data/
*.db

# --- tokenizer-bench research artifacts (belt-and-suspenders; the private source
#     corpus, model checkpoints, and the Python venv must never be published) ---
research/tokenizer-bench/data/
research/tokenizer-bench/runs/
research/tokenizer-bench/.venv/

# --- Secrets / local env ---
.env
.env.*
!.env.example

# --- Local Cargo override (ADR-00016): carries a machine path to the real
#     momusdev_llm engine; local-only. The committed .example documents it. ---
.cargo/config.toml

# --- Logs / scratch ---
*.log
*.tmp

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
