{
  "name": "human-document-tree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D graph frontend for human-document-tree — walks a document and renders its structure as a navigable, animated 3D graph.",
  "scripts": {
    "build:wasm": "wasm-pack build crates/doctree-wasm --target web --out-dir ../../src/wasm --out-name doctree_wasm",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/three": "^0.184.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "3d-force-graph": "^1.80.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "pdfjs-dist": "^6.0.227",
    "tesseract.js": "^7.0.0"
  }
}
